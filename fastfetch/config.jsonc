{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "kitty",
        "source": "/home/aashiqed/Downloads/logo.png",
        "width": 35,
        "height": 16,
        "padding": {
            "top": 1,
            "left": 2,
            "right": 4
        }
    },
    "display": {
        "separator": "  󰁔  ",
        "color": {
            "separator": "38;5;240"
        }
    },
    "modules": [
        "break",
        {
            "type": "title",
            "color": {
                "user": "38;5;45",
                "at": "38;5;240",
                "host": "38;5;197"
            }
        },
        {
            "type": "separator",
            "string": "━"
        },
        {
            "type": "os",
            "key": "󰣇 OS",
            "keyColor": "38;5;45"
        },
        {
            "type": "kernel",
            "key": "󰌢 Kernel",
            "keyColor": "38;5;45"
        },
        {
            "type": "uptime",
            "key": "󰅐 Uptime",
            "keyColor": "38;5;45"
        },
        {
            "type": "packages",
            "key": "󰏗 Packages",
            "keyColor": "38;5;45"
        },
        {
            "type": "shell",
            "key": "󰆍 Shell",
            "keyColor": "38;5;45"
        },
        {
            "type": "wm",
            "key": "󰨇 WM",
            "keyColor": "38;5;45"
        },
        {
            "type": "terminal",
            "key": "󰆍 Terminal",
            "keyColor": "38;5;45"
        },
        {
            "type": "cpu",
            "key": "󰻠 CPU",
            "keyColor": "38;5;45"
        },
        {
            "type": "gpu",
            "key": "󰍛 GPU",
            "keyColor": "38;5;45"
        },
        {
            "type": "memory",
            "key": "󰾆 Memory",
            "keyColor": "38;5;45"
        },
        "break",
        "colors",
        "break"
    ]
}
